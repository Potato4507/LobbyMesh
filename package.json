{
  "name": "companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "package:friend": "node scripts/package-friend.mjs",
    "verify:package": "node scripts/verify-windows-package.mjs",
    "test": "tsx --test tests/*.test.ts tests/simulation/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "start": "electron dist/main.cjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:audio": "node scripts/audio-smoke.mjs",
    "test:media-host": "node scripts/audio-smoke.mjs host",
    "test:voice-calls": "node scripts/audio-smoke.mjs calls",
    "test:independent-voice": "node scripts/independent-voice-smoke.mjs",
    "test:send-recovery": "node scripts/independent-voice-smoke.mjs --send-recovery",
    "test:voice-crash": "node scripts/independent-voice-smoke.mjs --crash",
    "diagnose:session": "tsx scripts/session-status.ts",
    "diagnose:handoff": "node scripts/native-handoff.mjs",
    "lab:peer": "tsx scripts/lab-peer.ts",
    "lab:pair": "tsx scripts/lab-pair.ts",
    "lab:doctor": "tsx scripts/lab-doctor.ts",
    "smoke:public-pair": "node scripts/public-pair-smoke.mjs",
    "simulate:overlay": "tsx scripts/simulate-overlay.ts",
    "test:contact-recovery": "node scripts/independent-voice-smoke.mjs --contact-recovery",
    "verify:windows": "pwsh -NoProfile -File scripts/verify-windows.ps1",
    "lab:package": "node --import tsx scripts/package-lab.mjs"
  },
  "dependencies": {
    "hyperdht": "6.35.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
